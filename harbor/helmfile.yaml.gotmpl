repositories:
  - name: harbor
    url: https://helm.goharbor.io
releases:
  - name: harbor-middleware
    namespace: db
    chart: main/raw
    values:
      - resources:
          - apiVersion: traefik.io/v1alpha1
            kind: Middleware
            metadata:
              name: harbor-proxy-headers-magic
            spec:
              headers:
                customRequestHeaders:
                  X-Forwarded-Proto: "https"
  - name: harbor
    namespace: db
    chart: harbor/harbor
    strategicMergePatches:
      - apiVersion: v1
        kind: ConfigMap
        metadata:
          name: harbor-core
          namespace: db
        data:
          CORE_URL: http://harbor-core.db.svc.cluster.local
    values:
      - database:
          internal:
            affinity:
              nodeAffinity:
                requiredDuringSchedulingIgnoredDuringExecution:
                  nodeSelectorTerms:
                    - matchExpressions:
                        - key: kubernetes.io/arch
                          operator: In
                          values:
                            - amd64
            resources:
              limits:
                memory: "300Mi"
              requests:
                memory: "50Mi"
      - portal:
          affinity:
            nodeAffinity:
              requiredDuringSchedulingIgnoredDuringExecution:
                nodeSelectorTerms:
                  - matchExpressions:
                      - key: kubernetes.io/arch
                        operator: In
                        values:
                          - amd64
                      # Previously excluded both xpand and jonapot, which left
                      # k8s-2 as the only eligible node. k8s-2 is cordoned for
                      # maintenance, so portal was unschedulable. jonapot stays
                      # excluded (979Mi node, already ~95% memory limits), so
                      # this now permits xpand.
                      - key: kubernetes.io/hostname
                        operator: NotIn
                        values:
                          - jonapot
          image:
            repository: goharbor/harbor-portal
            tag: dev
          resources:
            limits:
              memory: "300Mi"
            requests:
              memory: "20Mi"
      - core:
          replicas: 2
          image:
            repository: goharbor/harbor-core
            tag: dev
          affinity:
            podAntiAffinity:
              requiredDuringSchedulingIgnoredDuringExecution:
                - labelSelector:
                    matchLabels:
                      app: harbor
                      component: core
                  topologyKey: kubernetes.io/hostname
            nodeAffinity:
              requiredDuringSchedulingIgnoredDuringExecution:
                nodeSelectorTerms:
                  # The "- matchExpressions:" wrapper below was missing, so these
                  # keys parsed as a bare list item and Helm rendered the whole
                  # term as [{}]. An empty nodeSelectorTerm matches NO node, so
                  # every new core pod sat Pending with
                  # "8 node(s) didn't match Pod's node affinity/selector".
                  - matchExpressions:
                      - key: kubernetes.io/arch
                        operator: In
                        values:
                          - amd64
                      # jonapot is a 979Mi node already at ~95% memory limits.
                      - key: kubernetes.io/hostname
                        operator: NotIn
                        values:
                          - jonapot
          resources:
            limits:
              memory: "300Mi"
            requests:
              memory: "50Mi"

      - jobservice:
          maxJobWorkers: 1
          jobLoggers:
            - stdout
          affinity:
            nodeAffinity:
              requiredDuringSchedulingIgnoredDuringExecution:
                nodeSelectorTerms:
                  - matchExpressions:
                      - key: kubernetes.io/arch
                        operator: In
                        values:
                          - amd64
          replicas: 1
          resources:
            limits:
              memory: "300Mi"
            requests:
              memory: "50Mi"
      - registry:
          affinity:
            nodeAffinity:
              requiredDuringSchedulingIgnoredDuringExecution:
                nodeSelectorTerms:
                  - matchExpressions:
                      - key: kubernetes.io/arch
                        operator: In
                        values:
                          - amd64
                      - key: kubernetes.io/hostname
                        operator: NotIn
                        values:
                          - xpand
          #controller:
            #image:
              #repository: bitnami/harbor-registryctl
              #tag: 2.13.1
          registry:
            resources:
              limits:
                memory: "300Mi"
              requests:
                memory: "50Mi"
      - expose:
          tls:
            enabled: false
          ingress:
            hosts:
              core: harbor.gladiators.dev
              className: traefik
            annotations:
              traefik.ingress.kubernetes.io/router.middlewares: db-harbor-proxy-headers-magic@kubernetescrd

      - externalURL: https://harbor.gladiators.dev
      - persistence:
          resourcePolicy: drop
      - trivy:
          enabled: false
      - redis:
          type: external
          external:
            addr: redis-master.db.svc.cluster.local:6379
      - logLevel: error
      - secret.yaml
